# ============================================
# AI Marketing Automation System - Environment
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://ama_user:ama_password_2026@localhost:5432/ama_db

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=ama-jwt-secret-change-in-production-2026
JWT_EXPIRES_IN=24h

# AI - Claude (Primary)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI - OpenAI GPT-4o (Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# AWS S3 (set USE_LOCAL_STORAGE=true to skip S3)
USE_LOCAL_STORAGE=true
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=ama-content-uploads

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@company.com
MARKETING_EMAIL=marketing@company.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
